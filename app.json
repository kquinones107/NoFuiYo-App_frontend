{
  "expo": {
    "name": "NoFuiYoApp",
    "slug": "NoFuiYoApp",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zanacode.nofuiyo",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "Usamos tu galería para que puedas seleccionar una imagen como evidencia al completar una tarea del hogar. Por ejemplo, puedes subir una foto de la cocina limpia después de terminar la tarea.",
        "NSCameraUsageDescription": "Usamos la cámara para que puedas tomar una foto como evidencia al completar una tarea del hogar. Por ejemplo, puedes tomar una foto de la cocina limpia después de terminar la tarea."
      },
      "entitlements": {
        "com.apple.developer.associated-domains": ["applinks:natural-lionfish-20.clerk.accounts.dev"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "versionCode": 2,
      "package": "com.zanacode.NoFuiYoApp"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a05e057c-58a4-4037-8b22-754b4aff6754"
      }
    },
    "owner": "zanacode",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/a05e057c-58a4-4037-8b22-754b4aff6754"
    }
  }
}
